{
  "private": true,
  "name": "remnote-raindrop-plugin",
  "version": "1.0.1",
  "license": "MIT",
  "scripts": {
    "check-types": "tsc",
    "test": "vitest run",
    "dev": "cross-env NODE_ENV=development webpack-dev-server --color --progress --no-open",
    "build": "npx remnote-plugin validate && shx rm -rf dist && cross-env NODE_ENV=production webpack --color --progress && cd dist && bestzip ../PluginZip.zip ./*"
  },
  "dependencies": {
    "@remnote/plugin-sdk": "^0.0.46",
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "devDependencies": {
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@types/node": "^22.20.5",
    "@types/react": "^17.0.2",
    "@types/react-dom": "^17.0.2",
    "autoprefixer": "^10.4.7",
    "bestzip": "^4.0.3",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "esbuild-loader": "^4.5.0",
    "glob": "^14.0.4",
    "html-webpack-plugin": "^5.5.0",
    "mini-css-extract-plugin": "^2.6.1",
    "postcss": "^8.4.14",
    "postcss-import": "^17.0.1",
    "postcss-loader": "^8.2.1",
    "react-refresh": "^0.19.0",
    "shx": "^0.4.0",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.1.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "webpack": "^5.73.0",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0"
  },
  "overrides": {
    "bestzip": {
      "glob": "^14.0.4",
      "minimatch": "^11.0.5"
    },
    "glob": {
      "minimatch": "^11.0.5"
    },
    "readdir-glob": {
      "minimatch": "^11.0.5"
    }
  }
}
